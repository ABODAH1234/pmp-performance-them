<section class="pmp-departments container" component-id="{{ componentId }}"><div class="pmp-section-heading"><h2>{{ component.title }}</h2><span>POWER MATCH PERFORMANCE</span></div><div class="pmp-department-grid">{% for item in component.items %}<a class="pmp-department" href="{{ item.url }}"><span class="pmp-department__number">{{ item.number }}</span><h3>{{ item.title }}</h3><p>{{ item.subtitle }}</p><i class="sicon-arrow-left" aria-hidden="true"></i></a>{% endfor %}</div></section>
