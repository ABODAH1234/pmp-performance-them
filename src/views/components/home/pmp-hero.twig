<section class="pmp-hero container" component-id="{{ componentId }}">
  {% if component.url %}<a href="{{ component.url }}" aria-label="{{ component.button }}">{% endif %}
  <img src="{{ component.image ?: ('images/pmp-hero-banner.png'|asset) }}" alt="{{ component.caption }}" width="2172" height="724" fetchpriority="high">
  {% if component.url %}</a>{% endif %}
</section>
